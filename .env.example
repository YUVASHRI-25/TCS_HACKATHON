# Config files (the dataset location is declared inside mapping.yaml -> source)
TRACE_MAPPING_PATH=config/mapping.yaml
TRACE_DETECTORS_PATH=config/detectors.yaml
TRACE_CATALOGUES_PATH=config/catalogues.yaml
TRACE_PROCESSED_DIR=data/processed

# Relational store (SQLite default, Postgres optional)
DATABASE_URL=sqlite:///data/processed/trace.db
# DATABASE_URL=postgresql+psycopg://trace:trace@localhost:5432/trace

# Graph backend: networkx (default; always the analytics engine) | neo4j (optional persistence)
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM: none | gemini | anthropic | openai   (none = deterministic template fallbacks)
LLM_PROVIDER=none
LLM_MODEL=
# Server-side only. Any OpenAI-compatible endpoint (OpenRouter, Gemini OpenAI endpoint, ...). A GEMINI_API_KEY alone
# selects Gemini (model gemini-2.5-flash). If unset/unreachable the copilot returns an explicit 503; there is no fallback.
LLM_API_KEY=
LLM_BASE_URL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional ML tier: pyg | node2vec
GNN_BACKEND=node2vec

# Real-time replay (set when Phase 7 is configured)
REPLAY_SPEEDUP=
REPLAY_BATCH_SIZE=

API_HOST=127.0.0.1
API_PORT=8000
